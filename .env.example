# Copy to .env and fill in. Never commit .env.

# --- LLM (required) --------------------------------------------------------
# Key from https://console.groq.com/keys
GROQ_API_KEY=

# Optional: only needed if you point a model back at Gemini.
# langchain-google-genai reads GOOGLE_API_KEY; it does not read GEMINI_API_KEY.
# GOOGLE_API_KEY=

# --- LLM call limits (optional) --------------------------------------------
# Bound how long a throttled provider can stall a request.
# LLM_TIMEOUT_SECONDS=120
# LLM_MAX_RETRIES=2
# LLM_STRUCTURED_ATTEMPTS=3

# --- Elasticsearch ---------------------------------------------------------
# These defaults match docker-compose.yml; leave them as-is for local dev.
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_USER=elastic
ELASTICSEARCH_PASSWORD=changeme

# For Elastic Cloud instead, set retriever_provider="elastic" and use:
# ELASTICSEARCH_URL=https://<deployment>.es.<region>.cloud.es.io
# ELASTICSEARCH_API_KEY=

# --- API: Postgres and Redis -----------------------------------------------
# These defaults match docker-compose.yml, which publishes on non-default host
# ports so it does not collide with an existing local Postgres or Redis.
DATABASE_URL=postgresql+asyncpg://research:changeme@localhost:5434/research_agent
REDIS_URL=redis://localhost:6380/0
# Ingestion jobs run at once per worker.
# WORKER_CONCURRENCY=3

# --- Tracing (optional but recommended) ------------------------------------
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=research-rag-agent

# --- Alternative embedding providers (optional) ----------------------------
# Only needed if you switch embedding_model away from the local fastembed default.
# Groq serves chat models only, not embeddings, so embeddings stay local
# on fastembed unless you set one of these.
# OPENAI_API_KEY=
# COHERE_API_KEY=

# --- Alternative vector stores (optional) ----------------------------------
# PINECONE_API_KEY=
# PINECONE_INDEX_NAME=
# MONGODB_URI=
